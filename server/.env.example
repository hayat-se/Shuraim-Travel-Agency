# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Prisma → Supabase Postgres) ────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "URI".
# Use the POOLED connection (port 6543) for the app; append ?pgbouncer=true.
# Prisma migrate/db pull needs the DIRECT connection (port 5432) as DIRECT_URL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000,https://shuraim-travel-agency.vercel.app

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── Supabase (used for Storage: ticket PDFs / logos) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── Bookings ─────────────────────────────────────────────────────────────────
# Minutes a 'hold' booking survives before the scheduler auto-releases seats.
HOLD_EXPIRY_MINUTES=30
