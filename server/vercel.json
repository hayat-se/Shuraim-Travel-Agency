{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/", "dest": "/api/root.js" },
    { "src": "/favicon.ico", "dest": "/api/favicon.js" },
    { "src": "/meta.json", "dest": "/api/meta.js" }
  ]
}
