{
  "name": "airline-agency-backend",
  "version": "2.0.0",
  "description": "B2B Airline Agency Management System Backend (Express + Prisma)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
